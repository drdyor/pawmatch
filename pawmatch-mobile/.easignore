# EAS Build ignore file
# Files and directories to exclude from builds

node_modules/
.expo/
.expo-shared/
dist/
web-build/
*.log
.DS_Store
Thumbs.db

# Environment files (use EAS secrets instead)
.env.local
.env.*.local

# Git
.git/
.gitignore

# IDE
.vscode/
.idea/
*.swp
*.swo

# Documentation
*.md
!README.md

# Test files
**/__tests__/
**/*.test.*
**/*.spec.*
